{
  "name": "pinguino-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "recipes:import": "node scripts/importFlavorCatalogue.mjs",
    "recipes:validate": "node scripts/importFlavorCatalogue.mjs --check",
    "process:validate": "node scripts/buildProcessMetadataSeed.mjs --check",
    "toolbox:compositions": "node scripts/buildCanonicalToolboxCompositions.mjs",
    "toolbox:compositions:check": "node scripts/buildCanonicalToolboxCompositions.mjs --check",
    "products:audit": "node scripts/auditUnifiedProductIntelligence.mjs",
    "mapper:runtime-audit": "node scripts/auditMapperRuntimeUsability.mjs",
    "catalog:mapper-only:validate": "node scripts/validateMapperOnlyCatalog.mjs",
    "production-rescue:bundle": "node scripts/buildProductionRescueEdgeBundle.mjs",
    "production-rescue:bundle-check": "node scripts/buildProductionRescueEdgeBundle.mjs --check",
    "protein:corpus": "node scripts/buildInternetProteinRecipeCorpus.mjs",
    "protein:corpus:check": "node scripts/buildInternetProteinRecipeCorpus.mjs --check",
    "protein:behavior-audit": "node scripts/buildProteinProductBehaviorBindingAudit.mjs",
    "vegan:campaign": "vitest run --config vitest.campaign.config.ts",
    "crown:campaign": "vitest run --config vitest.crown-campaign.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/noto-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/react": "^10.66.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.101.0",
    "barcode-detector": "^3.2.2",
    "bwip-js": "^4.11.4",
    "heic-to": "^1.5.2",
    "html2canvas": "^1.4.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.17.0",
    "tesseract.js": "7.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "@tesseract.js-data/pol": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.4",
    "rolldown": "1.0.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
